<%# Feature B: draw names & send reminders %>
<%- include('partials/header', { title: 'Your Draw' }) %>

<div class="page-head">
  <div>
    <p class="group-name"><%= group.name %></p>
    <h1 class="page-title">Who did you draw?</h1>
  </div>
  <div>
    <a class="btn btn-outline-light" href="/groups/<%= group.id %>/hints">Go to Hints</a>
    <a class="btn btn-outline-light" href="/groups/<%= group.id %>/reveal">Go to Reveal</a>
  </div>
</div>

<div class="paper">
  <% if (!group.drawn_at) { %>
    
    <div class="text-center py-4">
      <h2>Names haven't been drawn yet.</h2>
      <% if (group.organizer_id === user.id) { %>
        <p class="hint">As the organizer, you can trigger the draw once everyone has joined.</p>
        <form method="post" action="/groups/<%= group.id %>/draw" class="mt-3">
          <button class="btn btn-primary btn-lg">Draw Names Now</button>
        </form>
      <% } else { %>
        <p class="hint">Waiting for the organizer to draw names.</p>
      <% } %>
    </div>
    
  <% } else if (assignment) { %>
    
    <div class="text-center mb-4">
      <h2 class="h4 hint mb-1">You are buying a gift for</h2>
      <h3 class="thread-title text-primary" style="font-size: 2.5rem;"><%= assignment.name %></h3>
    </div>

    <hr class="my-4" style="border-color: var(--gold); opacity: 0.3;">

    <h4 class="mb-3">Their Wishlist</h4>
    <% if (wishlist && wishlist.length > 0) { %>
      <ul class="list-group list-group-flush mb-4">
        <% wishlist.forEach(item => { %>
          <li class="list-group-item bg-transparent px-0 d-flex justify-content-between align-items-center">
            <span style="font-size: 1.1rem;"><%= item.title %></span>
            <% if (item.link) { %>
              <a href="<%= item.link %>" target="_blank" class="btn btn-sm btn-outline-primary">View Link</a>
            <% } %>
          </li>
        <% }) %>
      </ul>
    <% } else { %>
      <p class="hint mb-4"><%= assignment.name %> hasn't added anything to their wishlist yet.</p>
    <% } %>

    <div class="text-center">
      <a href="/groups/<%= group.id %>/hints" class="btn btn-primary">Send them an anonymous hint</a>
    </div>

  <% } else { %>
    <p>Names have been drawn, but we couldn't find your assignment. You may have joined after the draw occurred.</p>
  <% } %>
</div>

<%- include('partials/footer') %>
