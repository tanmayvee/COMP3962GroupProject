# copy this to .env (cp .env.example .env) - never commit the real .env

PORT=3000
SESSION_SECRET=change-me-to-anything-random

# embedded = npm starts a bundled postgres for you (local dev, nothing to install)
# external = connect to a postgres you run yourself, e.g. RDS on AWS
DB_MODE=embedded

# port 5433 so it won't clash if someone already has postgres installed on 5432
DATABASE_URL=postgres://santa:santa@localhost:5433/secret_santa

# "local" = photos saved to /uploads
STORAGE_DRIVER=local

# only needed once things are switched to "aws"
AWS_PROFILE=team
AWS_REGION=us-west-2
S3_BUCKET=
